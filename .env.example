# Copy to .env and fill in real values. NEVER commit .env to Git.
# Supabase project: ivmkvwudblcqhtoiqlaf
# Project URL: https://ivmkvwudblcqhtoiqlaf.supabase.co

# --- Supabase (server-side only) ---
SUPABASE_URL=https://ivmkvwudblcqhtoiqlaf.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- Auth ---
# At least 32 random characters; server startup rejects weak/default values.
AUTH_SECRET=
AUTH_TOKEN_EXPIRE_MINUTES=480

# --- Storage ---
STORAGE_URL=
STORAGE_BUCKET=land-record-documents
MAX_UPLOAD_MB=10

# --- AI providers (backend only, never frontend) ---
GEMINI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
GROQ_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash
AI_TIMEOUT_SECONDS=60
# Ordered fallback lanes: "provider:model" pairs tried after one retry
# each (transient failures only). Example:
# AI_FALLBACKS=openrouter:meta-llama/llama-3.3-70b-instruct,gemini:gemini-2.0-flash
AI_FALLBACKS=
AI_CACHE_ENABLED=true
AI_CACHE_TTL_SECONDS=3600
AI_CACHE_MAX_ENTRIES=256

# --- Backend ---
ENVIRONMENT=development
FRONTEND_ORIGINS=http://localhost:5173
# Comma-separated explicit browser origins; wildcard origins are rejected.
LOG_LEVEL=INFO

# --- Runtime flags ---
DEMO_MODE=false
